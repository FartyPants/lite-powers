{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' \"$(<\"${CLAUDE_PLUGIN_ROOT}/hooks/context.md\")\"",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ]
  }
}
